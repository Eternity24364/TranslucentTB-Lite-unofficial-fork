#pragma code_page(65001)

#ifdef APSTUDIO_INVOKED
#error Please edit this file manually.
#endif

#include <ddeml.h>
#include <winres.h>
#include "../../../Common/appinfo.hpp"
#include "../ids.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
	FILEVERSION APP_VERSION_FIXED
	PRODUCTVERSION APP_VERSION_FIXED
	FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
	FILEFLAGS VS_FF_DEBUG
#endif
	FILEOS VOS_NT_WINDOWS32
	FILETYPE VFT_APP
{
	BLOCK L"StringFileInfo"
	{
		BLOCK L"080404b0"
		{
			VALUE L"FileDescription", APP_DISPLAY_NAME
			VALUE L"FileVersion", APP_VERSION
			VALUE L"InternalName", APP_NAME L".exe"
			VALUE L"OriginalFilename", APP_NAME L".exe"
			VALUE L"ProductName", APP_DISPLAY_NAME
			VALUE L"ProductVersion", APP_VERSION
			VALUE L"Comments", L"一个能够使 Windows 任务栏半透明/透明的轻量小工具"
			VALUE L"CompanyName", L"TranslucentTB 开源开发者"
			VALUE L"LegalCopyright", L"版权所有 © " APP_COPYRIGHT_YEAR L" TranslucentTB 开源开发者；修改部分 © 2026 TranslucentTB Lite 贡献者"
		}
	}
	BLOCK L"VarFileInfo"
	{
		VALUE L"Translation", 0x0804, CP_WINUNICODE
	}
}


/////////////////////////////////////////////////////////////////////////////
//
// Strings
//

STRINGTABLE
{
	IDS_ALREADY_RUNNING APP_DISPLAY_NAME L" 已经在运行了！右键点击托盘图标以打开菜单。"
	IDS_RESTART_REQUIRED APP_DISPLAY_NAME L" 已更新。请重启 Windows 以使用最新版本。"
	IDS_EXPLORER_RESTARTED_TOO_MUCH L"文件资源管理器在过去的30秒中重启了两次！这可能是 " APP_DISPLAY_NAME " 与其他命令行自定义软件之间的冲突，或者是由于 Windows 更新引起的。为了避免出现更多的问题，" APP_DISPLAY_NAME " 将退出。"
	IDS_EXIT L"退出"
}
