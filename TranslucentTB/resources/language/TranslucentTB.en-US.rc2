#pragma code_page(65001)

#ifdef APSTUDIO_INVOKED
#error Please edit this file manually.
#endif

#include <ddeml.h>
#include <winres.h>
#include "../../../Common/appinfo.hpp"
#include "../ids.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
	FILEVERSION APP_VERSION_FIXED
	PRODUCTVERSION APP_VERSION_FIXED
	FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
	FILEFLAGS VS_FF_DEBUG
#endif
	FILEOS VOS_NT_WINDOWS32
	FILETYPE VFT_APP
{
	BLOCK L"StringFileInfo"
	{
		BLOCK L"040904b0"
		{
			VALUE L"FileDescription", APP_DISPLAY_NAME
			VALUE L"FileVersion", APP_VERSION
			VALUE L"InternalName", APP_NAME L".exe"
			VALUE L"OriginalFilename", APP_NAME L".exe"
			VALUE L"ProductName", APP_DISPLAY_NAME
			VALUE L"ProductVersion", APP_VERSION
			VALUE L"Comments", L"A lightweight utility that makes the Windows taskbar translucent/transparent."
			VALUE L"CompanyName", L"TranslucentTB Open Source Developers"
			VALUE L"LegalCopyright", L"Copyright © " APP_COPYRIGHT_YEAR L" TranslucentTB Open Source Developers; modifications © 2026 TranslucentTB Lite contributors"
		}
	}
	BLOCK L"VarFileInfo"
	{
		VALUE L"Translation", 0x0409, CP_WINUNICODE
	}
}


/////////////////////////////////////////////////////////////////////////////
//
// Strings
//

STRINGTABLE
{
	IDS_ALREADY_RUNNING APP_DISPLAY_NAME L" is already running! Right-click on the tray icon to access it."
	IDS_RESTART_REQUIRED APP_DISPLAY_NAME L" was recently updated. Please restart Windows to start using the latest version."
	IDS_EXPLORER_RESTARTED_TOO_MUCH L"Windows Explorer restarted twice in the last 30 seconds! This may be a conflict between " APP_DISPLAY_NAME " and other shell customization software, or a Windows Update. To avoid further issues, " APP_DISPLAY_NAME " will now exit."
	IDS_EXIT L"Exit"
}
